<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timerFragmentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".exercise.timer.view.TimerFragment">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/exerciseProgress"

        style="@style/Widget.Material3.CircularProgressIndicator"
        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:progress="50"
        app:indicatorSize="300dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="?colorSurfaceContainer"
        app:trackCornerRadius="8dp"
        app:trackThickness="24dp" />

    <TextView
        android:id="@+id/exerciseCounter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="64dp"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:requiresFadingEdge="horizontal"
        android:singleLine="true"
        android:text="0"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/exerciseProgress"
        app:layout_constraintEnd_toEndOf="@+id/exerciseProgress"
        app:layout_constraintStart_toStartOf="@+id/exerciseProgress"
        app:layout_constraintTop_toTopOf="@+id/exerciseProgress"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="@dimen/timer_information_height"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/exerciseProgress"
        app:layout_constraintEnd_toEndOf="@+id/exerciseProgress"
        app:layout_constraintStart_toStartOf="@+id/exerciseProgress">

        <ImageView
            android:id="@+id/exerciseIcon"
            android:layout_width="@dimen/timer_information_lateral_width"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:scaleType="fitStart"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintBottom_toBottomOf="@+id/textView"
            app:layout_constraintStart_toStartOf="@+id/exerciseProgress"
            app:layout_constraintTop_toTopOf="@+id/textView"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription,ImageContrastCheck" />

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="64dp"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="\???"
            android:textSize="@dimen/timer_information_textsize"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/exerciseProgress"
            app:layout_constraintEnd_toEndOf="@+id/exerciseProgress"
            app:layout_constraintStart_toStartOf="@+id/exerciseProgress"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/setCounter"
            android:layout_width="@dimen/timer_information_lateral_width"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:gravity="center|right"
            android:singleLine="true"
            android:text="…/…"
            android:textSize="@dimen/timer_information_textsize"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/exerciseProgress"
            app:layout_constraintEnd_toEndOf="@+id/exerciseProgress"
            app:layout_constraintStart_toStartOf="@+id/exerciseProgress"
            tools:ignore="HardcodedText,RtlHardcoded,TextSizeCheck" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
