<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addTagLayout"
    android:layout_width="@dimen/chip_height"
    android:layout_height="@dimen/chip_height"
    android:background="@drawable/bg_chip_add"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/chip_icon_size"
        android:layout_height="@dimen/chip_icon_size"
        android:layout_weight="1"
        app:srcCompat="@drawable/ic_ui_add"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>
